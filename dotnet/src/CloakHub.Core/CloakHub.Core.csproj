<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" />
  </ItemGroup>

  <!--
    The launch layer keeps its argument assembly and binary-version parsing
    internal: they are implementation detail, not API other assemblies should
    build against. They are also the two places where a silent mistake is most
    expensive - a dropped fingerprint flag, or a version comparison that picks
    the older browser - so they are asserted directly rather than inferred from
    the outside. This grant is what lets both be true at once.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>CloakHub.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Embedded rather than copied next to the executable. The badge renderer needs
    the base icon at launch time, and a single-file publish - which is what the
    user will actually download - has no reliable directory to read a loose PNG
    from. Embedding removes the failure mode entirely.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\app-icon.png" LogicalName="CloakHub.Core.Assets.app-icon.png" />
  </ItemGroup>

</Project>
