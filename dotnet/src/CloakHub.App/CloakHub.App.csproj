<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AvaloniaNameGeneratorIsEnabled>true</AvaloniaNameGeneratorIsEnabled>

    <!--
      Compiled bindings for every view. Without this, a binding to a property that
      does not exist fails silently at runtime and shows an empty field, which is
      the single easiest way to ship a broken screen: the XAML looks right and the
      app starts. With it, the same mistake is a build error.

      This is why every view declares x:DataType: the compiler needs the target
      type to resolve paths against.
    -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CloakBrowserHub</AssemblyName>
    <RootNamespace>CloakHub.App</RootNamespace>

    <!--
      The Win32 icon compiled into the .exe. This is what Explorer, the taskbar and
      the Alt-Tab list read, and they read it from the file itself - before any of
      our code runs, so the runtime Window.Icon below cannot cover it. Both are
      needed: this one for the executable at rest, that one for the live window
      (and for X11, where there is no equivalent of an embedded resource icon).

      Ignored by the compiler on non-Windows hosts, so it is safe unconditionally.
    -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      11.3.x rather than 12.1.0. Avalonia 12 does target net8.0, but it is only
      weeks old and this project's whole point is running correctly on Windows and
      macOS, which cannot be verified from this Linux sandbox. The mature 11.3 line
      is the safer base for a port whose cross-platform behaviour has to be trusted
      before it can be tested.
    -->
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />

    <!-- Compiled bindings need this to report binding errors at build time. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloakHub.Core\CloakHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    Fail the build when the icon assets are missing rather than shipping a
    nameless grey window.

    Assets/ is generated by build/make-icon.py from the brand master, and a fresh
    clone that skipped that step would otherwise compile cleanly and produce an
    app with no icon - a defect nobody notices until it is in front of a user,
    because the app is perfectly functional without one.
  -->
  <Target Name="VerifyIconAssets" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Assets/app-icon.png')"
           Text="Assets/app-icon.png is missing. Run: python3 build/make-icon.py" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/app.ico')"
           Text="app.ico is missing. Run: python3 build/make-icon.py" />
  </Target>

</Project>
