<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CloakHub.App.ViewModels"
             xmlns:views="using:CloakHub.App.Views"
             xmlns:svc="using:CloakHub.App.Services"
             mc:Ignorable="d"
             x:Class="CloakHub.App.Views.ProfilesView"
             x:DataType="vm:ProfilesPageViewModel">

  <!--
    A Panel at the root so the editor can cover the whole page.

    The editor is a sibling that replaces the list rather than a child of it, because
    it needs the full width: the summary rail alone is 300px, and nesting it inside
    the list's layout would leave it competing with the folder sidebar for space it
    does not need while the list is hidden anyway.
  -->
  <Panel>

  <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsListVisible}">

    <!-- ================================================================
         Topbar: title, count, search, create
         ================================================================ -->
    <Border Grid.Row="0" Padding="22,18"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto">

        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
          <!--
            The heading names the selected folder rather than being the fixed word
            "Profiles", so a filtered list explains its own length.
          -->
          <TextBlock Classes="h1" Text="{Binding ScopeLabel}" />
          <TextBlock Classes="sub" Text="{Binding CountLabel}" />
        </StackPanel>

        <TextBox Grid.Column="1" Width="240" Margin="12,0"
                 VerticalAlignment="Center"
                 Watermark="Search name, tag, proxy…"
                 Text="{Binding Query, Mode=TwoWay}" />

        <Button Grid.Column="2" Classes="primary" Content="New profile"
                VerticalAlignment="Center"
                Command="{Binding CreateCommand}" />
      </Grid>
    </Border>

    <!-- ================================================================
         Body: folders on the left, the table on the right
         ================================================================ -->
    <Grid Grid.Row="1" ColumnDefinitions="200,*">

    <!-- ================================================================
         Folders sidebar

         A flat list, not a tree. The store models folders as a single level, and a
         TreeView would promise nesting the data cannot express — dragging one folder
         onto another would have nowhere to record the result.
         ================================================================ -->
    <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*" Margin="12,16,12,12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,0,8">
          <TextBlock Grid.Column="0" Classes="th" Text="FOLDERS" VerticalAlignment="Center" />
          <!-- Glyph rather than the word "New": the column is 200px and the label already claims most of it. -->
          <Button Grid.Column="1" Classes="ghost" Content="+"
                  Padding="8,1" FontSize="{DynamicResource FontSizeSmall}"
                  ToolTip.Tip="New folder"
                  Command="{Binding AddFolderCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Folders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderNodeViewModel">
                <Panel Margin="0,0,0,1">

                  <!-- Normal state: the row is a button, with the count on the right. -->
                  <Button Classes="nav-item" Classes.active="{Binding IsSelected}"
                          IsVisible="{Binding IsNotRenaming}"
                          Command="{Binding SelectCommand}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding CountLabel}"
                                 Classes="faint mono" Margin="6,0,0,0"
                                 FontSize="{DynamicResource FontSizeTiny}"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <!--
                      Rename and delete live on the row's context menu rather than as
                      always-visible buttons. At this width two icon buttons per row
                      would leave almost nothing for the folder name, and both are
                      rare actions compared with selecting.
                    -->
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Rename" IsEnabled="{Binding CanEdit}"
                                  Command="{Binding BeginRenameCommand}" />
                        <MenuItem Header="Delete" IsEnabled="{Binding CanEdit}"
                                  Command="{Binding DeleteCommand}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>

                  <!--
                    Rename state: the text box takes the row's place.

                    Enter commits and Escape reverts, via KeyBindings rather than a
                    pair of buttons, because the field is 200px wide and the two
                    gestures are already universal for an inline edit.
                  -->
                  <TextBox IsVisible="{Binding IsRenaming}"
                           Text="{Binding RenameDraft, Mode=TwoWay}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Padding="8,5"
                           svc:FocusOnShow.Enabled="True">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
                      <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>

                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Grid>
    </Border>

    <Panel Grid.Column="1">

      <!--
        Two distinct empty states. "No profiles at all" needs a call to action; "none
        matched your search" needs the search term back, because the two look the
        same on screen but call for opposite responses from the user.
      -->
      <Border Classes="card" Margin="22" VerticalAlignment="Top" Padding="22"
              IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="10" MaxWidth="520">
          <TextBlock Text="No profiles yet" FontWeight="SemiBold" />
          <TextBlock Classes="dim" TextWrapping="Wrap"
                     Text="Each profile is a separate browsing identity — its own fingerprint, cookies and proxy. Create one to get started." />
          <Button Classes="primary" Content="New profile" HorizontalAlignment="Left"
                  Margin="0,4,0,0" Command="{Binding CreateCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card" Margin="22" VerticalAlignment="Top" Padding="22"
              IsVisible="{Binding HasNoMatches}">
        <StackPanel Spacing="6">
          <TextBlock Text="Nothing matched" FontWeight="SemiBold" />
          <TextBlock Classes="dim" TextWrapping="Wrap"
                     Text="No profile matched that search. It looks at names, notes, tags, proxy hosts and platforms." />
        </StackPanel>
      </Border>

      <!-- The table -->
      <Grid RowDefinitions="Auto,*" Margin="22,16,22,22">
        <Grid.IsVisible>
          <!--
            Hidden when either empty state is showing. Expressed as a binding on the
            row count rather than as "not IsEmpty and not HasNoMatches", which would
            need two converters to say the same thing.
          -->
          <Binding Path="Rows.Count" Converter="{x:Static vm:Converters.GreaterThanZero}" />
        </Grid.IsVisible>

        <!--
          The header and the rows must use identical column definitions, and the
          actions column has an explicit width rather than Auto for exactly that
          reason: Auto measures its content, the header cell for that column is
          empty, so it resolved to 0 in the header and ~180px in the rows. That left
          the proportional columns a different amount of space in each and the
          headers sat visibly off from the data they labelled.

          A DataGrid would give real column synchronisation, but it also brings its
          own theme, selection model and editing behaviour that would fight the
          CSS-derived styling for no benefit at six columns.
        -->
        <Border Grid.Row="0" Padding="12,0,12,8">
          <Grid ColumnDefinitions="4,1.8*,90,1.6*,85,90,190">
            <TextBlock Grid.Column="1" Classes="th" Text="NAME" />
            <TextBlock Grid.Column="2" Classes="th" Text="STATUS" />
            <TextBlock Grid.Column="3" Classes="th" Text="PROXY" />
            <TextBlock Grid.Column="4" Classes="th" Text="PLATFORM" />
            <TextBlock Grid.Column="5" Classes="th" Text="LAST USED" />
          </Grid>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileRowViewModel">
              <Border Padding="12,9" Margin="0,0,0,2"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <!-- Must match the header definition above exactly. -->
                <Grid ColumnDefinitions="4,1.8*,90,1.6*,85,90,190">

                  <!-- Accent swatch: a fixed-width bar, so the column never goes ragged. -->
                  <Border Grid.Column="0" Width="3" CornerRadius="2"
                          Background="{Binding ColourHex}" Margin="0,1,0,1" />

                  <!-- Name, with tags underneath when present. -->
                  <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,8,0"
                              VerticalAlignment="Center">
                    <!--
                      A Grid, not a horizontal StackPanel.

                      A StackPanel measures its children with infinite width along its
                      orientation, so TextTrimming never engaged and a long name drew
                      straight over the status column instead of being ellipsised. A
                      Grid gives the name a real constraint: a * column it must fit.
                    -->
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium"
                                 TextTrimming="CharacterEllipsis" />
                      <!-- The live instance number, matching the badge on the window. -->
                      <TextBlock Grid.Column="1" Text="{Binding InstanceLabel}"
                                 Classes="faint mono" Margin="7,0,0,0"
                                 FontSize="{DynamicResource FontSizeTiny}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsRunning}" />
                    </Grid>
                    <TextBlock Text="{Binding TagsLabel}" Classes="faint"
                               FontSize="{DynamicResource FontSizeTiny}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding HasTags}" />
                  </StackPanel>

                  <Border Grid.Column="2" Classes="badge" Classes.ok="{Binding IsRunning}"
                          HorizontalAlignment="Left">
                    <TextBlock Text="{Binding StatusLabel}" />
                  </Border>

                  <TextBlock Grid.Column="3" Text="{Binding ProxyLabel}"
                             Classes="mono" Margin="0,0,8,0"
                             Classes.faint="{Binding !HasProxy}"
                             FontSize="{DynamicResource FontSizeSmall}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />

                  <TextBlock Grid.Column="4" Text="{Binding PlatformLabel}"
                             Classes="dim" FontSize="{DynamicResource FontSizeSmall}"
                             VerticalAlignment="Center" />

                  <TextBlock Grid.Column="5" Text="{Binding LastUsedLabel}"
                             Classes="dim" FontSize="{DynamicResource FontSizeSmall}"
                             VerticalAlignment="Center" />

                  <!-- Row actions -->
                  <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <Button Classes="primary" Content="Start" Padding="12,4"
                            FontSize="{DynamicResource FontSizeSmall}"
                            IsVisible="{Binding IsStopped}"
                            Command="{Binding StartCommand}" />
                    <Button Content="Stop" Padding="12,4"
                            FontSize="{DynamicResource FontSizeSmall}"
                            IsVisible="{Binding IsRunning}"
                            Command="{Binding StopCommand}" />
                    <Button Content="Edit" Padding="12,4"
                            FontSize="{DynamicResource FontSizeSmall}"
                            Command="{Binding EditCommand}" />
                    <!--
                      Duplicate, Move and Delete collapse into one overflow menu.

                      Five buttons per row did not fit the 250px actions column, and
                      Start/Edit are the two used constantly; the rest are occasional.
                      The menu keeps the frequent pair full-size instead of shrinking
                      everything to fit the rarest action.
                    -->
                    <Button Classes="ghost" Content="⋯" Padding="10,4"
                            FontSize="{DynamicResource FontSizeSmall}"
                            ToolTip.Tip="More actions">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                          <!--
                            Each target carries its own bound command, so the submenu
                            does not have to reach back out of the popup to find the
                            row it belongs to. See MoveTargetViewModel.
                          -->
                          <MenuItem Header="Move to" ItemsSource="{Binding MoveTargets}">
                            <MenuItem.ItemContainerTheme>
                              <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                            x:DataType="vm:MoveTargetViewModel">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="Command" Value="{Binding MoveCommand}" />
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                              </ControlTheme>
                            </MenuItem.ItemContainerTheme>
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>

                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

    </Panel>
    </Grid>
  </Grid>

  <!-- ==================================================================
       The editor, covering the page while it is open
       ================================================================== -->
  <views:ProfileEditorView DataContext="{Binding Editor}"
                           IsVisible="{Binding $parent[UserControl].((vm:ProfilesPageViewModel)DataContext).IsEditorOpen}" />

  </Panel>
</UserControl>
